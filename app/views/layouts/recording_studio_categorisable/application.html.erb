<!DOCTYPE html>
<html data-theme="rounded">
  <head>
    <title><%= content_for(:title) || "Recording Studio Categorisable" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "flat_pack/variables", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "flat_pack/application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-[var(--surface-page-background-color)] text-[var(--surface-content-color)]">
    <main class="mx-auto min-h-screen w-full max-w-6xl px-6 py-8">
      <%= yield %>
    </main>
  </body>
</html>
