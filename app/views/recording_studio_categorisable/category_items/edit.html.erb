<div class="mx-auto w-full max-w-4xl px-6 py-12">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Edit category item",
    subtitle: "Revises the current item snapshot while preserving its usage history.",
    variant: :h1
  ) %>

  <% if @item_usage_count.positive? %>
    <div class="mb-4">
      <%= render FlatPack::Badge::Component.new(text: "#{@item_usage_count} active uses", style: :warning, size: :sm) %>
    </div>
  <% end %>

  <%= render "form", category_item: @category_item, submit_text: "Save category item" %>
</div>
