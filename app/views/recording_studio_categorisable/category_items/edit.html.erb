<div class="mx-auto flex w-full max-w-2xl flex-col gap-6 px-6 py-12">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Edit Category Item",
    subtitle: "Update category item details",
    variant: :h1
  ) %>

  <%= form_with model: @category_item, url: recording_studio_categorisable.category_group_category_item_path(@category_group_recording, @category_item_recording), method: :patch, class: "space-y-6" do |form| %>
    <% if @category_item.errors.any? %>
      <%= render FlatPack::Alert::Component.new(
        title: "#{pluralize(@category_item.errors.count, 'error')} prohibited this category item from being saved:",
        message: @category_item.errors.full_messages.join(", "),
        variant: :error
      ) %>
    <% end %>

    <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
      <% card.body do %>
        <div class="space-y-4">
          <div>
            <%= form.label :label, "Label", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.text_field :label, class: "w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500" %>
          </div>
        </div>
      <% end %>
    <% end %>

    <div class="flex gap-2">
      <%= form.button type: :submit, class: "inline-flex" do %>
        <%= render FlatPack::Button::Component.new(
          text: "Update Category Item",
          style: :primary,
          size: :md
        ) %>
      <% end %>
      <%= link_to recording_studio_categorisable.category_group_path(@category_group_recording), class: "inline-flex" do %>
        <%= render FlatPack::Button::Component.new(
          text: "Cancel",
          style: :ghost,
          size: :md
        ) %>
      <% end %>
    </div>
  <% end %>
</div>
