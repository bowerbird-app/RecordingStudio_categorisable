<% content_for :title, @category.recordable.name %>
<% content_for :subtitle, "Everything filed under this category, including nested ones." %>

<div class="mx-auto flex w-full max-w-5xl flex-col gap-6">
  <div class="flex justify-end">
    <%= render FlatPack::Button::Component.new(text: "All categories", style: :secondary, href: root_path) %>
  </div>

  <% if @recordings.empty? %>
    <%= render FlatPack::Card::Component.new do |card| %>
      <% card.body do %>
        <p class="text-sm">Nothing is in this category yet.</p>
      <% end %>
    <% end %>
  <% else %>
    <%= render FlatPack::Table::Component.new(data: @recordings, min_width: :none, class: "w-full") do |table| %>
      <% table.column(title: "Name", html: ->(recording) { RecordingStudio.recordable_name(recording.recordable) }) %>
      <% table.column(title: "Type", html: ->(recording) { RecordingStudio.recordable_type_label(recording.recordable_type) }) %>
    <% end %>
  <% end %>
</div>
