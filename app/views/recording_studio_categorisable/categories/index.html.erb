<% content_for :title, "Categories" %>
<% content_for :subtitle, "Group work into categories. Nest one inside another." %>

<div class="mx-auto flex w-full max-w-5xl flex-col gap-6">
  <div class="flex justify-end">
    <%= render FlatPack::Button::Component.new(text: "Add category", style: :primary, href: new_category_path) %>
  </div>

  <% if @categories.empty? %>
    <%= render FlatPack::Card::Component.new do |card| %>
      <% card.body do %>
        <p class="text-sm">Nothing here yet. Add a category to get going.</p>
      <% end %>
    <% end %>
  <% else %>
    <%
      actions = @categories.each_with_object({}) do |category, hash|
        hash[category.id] = capture do
          %>
            <%= render FlatPack::Button::Component.new(
              text: "Show items",
              style: :secondary,
              href: category_recordings_path(category)
            ) %>
          <%
        end
      end
    %>
    <%= render FlatPack::Table::Component.new(data: @categories, min_width: :none, class: "w-full") do |table| %>
      <% table.column(title: "Name", html: ->(category) { ("– " * [category.depth - 1, 0].max) + category.recordable.name }) %>
      <% table.column(title: "Inside", html: ->(category) { category.parent_recording&.recordable.try(:name) || "—" }) %>
      <% table.column(title: "", html: ->(category) { actions[category.id] }) %>
    <% end %>
  <% end %>
</div>
