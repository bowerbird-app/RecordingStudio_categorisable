<div class="mx-auto flex w-full max-w-6xl flex-col gap-6 px-6 py-12">
  <% category_group = @category_group_recording.recordable %>

  <%= render FlatPack::PageNav::Component.new(anchor_url: main_app.root_path) %>

  <%= render FlatPack::PageTitle::Component.new(
    title: category_group.name,
    subtitle: category_group.description.presence || "Manage items and review usage before destructive actions.",
    variant: :h1
  ) %>

  <div class="flex flex-wrap gap-2">
    <%= render FlatPack::Button::Component.new(
      text: "Add item",
      style: :primary,
      size: :sm,
      url: new_category_group_category_item_path(@category_group_recording)
    ) %>
    <%= render FlatPack::Button::Component.new(
      text: "Edit group",
      style: :secondary,
      size: :sm,
      url: edit_category_group_path(@category_group_recording)
    ) %>
    <% if @group_usage_count.zero? %>
      <%= render FlatPack::Button::Component.new(
        text: "Delete group",
        style: :secondary,
        size: :sm,
        url: category_group_path(@category_group_recording),
        method: :delete,
        data: { turbo_confirm: "Delete this category group and all of its items?" }
      ) %>
    <% else %>
      <% delete_tooltip = "Delete is disabled while this category group is in use by #{pluralize(@group_usage_count, 'recording')}." %>
      <%= render FlatPack::Tooltip::Component.new(text: delete_tooltip) do %>
        <%= render FlatPack::Button::Component.new(
          text: "Delete",
          style: :secondary,
          size: :sm,
          url: category_group_path(@category_group_recording),
          method: :delete,
          class: "pointer-events-none cursor-not-allowed opacity-50",
          aria: { disabled: true },
          tabindex: -1
        ) %>
      <% end %>
    <% end %>
  </div>

  <%= render FlatPack::PageTitle::Component.new(
    title: "Category items",
    subtitle: "Usage counts are calculated from explicit categorisable registrations.",
    variant: :h3,
    class: "mb-0 pb-0"
  ) %>

  <% item_name_cell = lambda do |category_item_recording|
       category_item = category_item_recording.recordable

       capture do %>
         <div class="space-y-1">
           <div class="font-medium"><%= category_item.name %></div>
           <div class="text-xs text-(--surface-muted-content-color)"><%= category_item.description.presence || "No description" %></div>
         </div>
       <% end
     end %>

  <% item_key_cell = lambda do |category_item_recording|
       category_item_recording.recordable.key
     end %>

  <% item_position_cell = lambda do |category_item_recording|
       category_item_recording.recordable.position
     end %>

  <% item_usage_cell = lambda do |category_item_recording|
       item_usage_count = @usage_report.item_usage_count(category_item_recording)

       "#{item_usage_count} uses"
     end %>

  <% item_actions_cell = lambda do |category_item_recording|
       item_usage_count = @usage_report.item_usage_count(category_item_recording)

       capture do %>
         <div class="flex flex-wrap gap-2">
           <%= render FlatPack::Button::Component.new(
             text: "Edit",
             style: :secondary,
             size: :sm,
             url: edit_category_group_category_item_path(@category_group_recording, category_item_recording)
           ) %>
           <% if item_usage_count.zero? %>
             <%= render FlatPack::Button::Component.new(
               text: "Delete",
               style: :secondary,
               size: :sm,
               url: category_group_category_item_path(@category_group_recording, category_item_recording),
               method: :delete,
               data: { turbo_confirm: "Delete this category item?" }
             ) %>
           <% else %>
            <% delete_tooltip = "Delete is disabled while this category item is used by #{pluralize(item_usage_count, 'recording')}." %>
            <%= render FlatPack::Tooltip::Component.new(text: delete_tooltip) do %>
              <%= render FlatPack::Button::Component.new(
                text: "Delete",
                style: :secondary,
                size: :sm,
                url: category_group_category_item_path(@category_group_recording, category_item_recording),
                method: :delete,
                class: "pointer-events-none cursor-not-allowed opacity-50",
                aria: { disabled: true },
                tabindex: -1
              ) %>
            <% end %>
           <% end %>
         </div>
       <% end
     end %>

  <%= render FlatPack::Table::Component.new(data: @category_item_recordings) do |table| %>
    <% table.column(title: "Name", html: item_name_cell) %>
    <% table.column(title: "Key", html: item_key_cell) %>
    <% table.column(title: "Position", html: item_position_cell) %>
    <% table.column(title: "Usage", html: item_usage_cell) %>
    <% table.column(title: "Actions", html: item_actions_cell) %>
  <% end %>
</div>
