<div class="mx-auto flex w-full max-w-4xl flex-col gap-6 px-6 py-12">
  <%= render FlatPack::PageTitle::Component.new(
    title: @category_group_recording.recordable.label,
    subtitle: "Category group details",
    variant: :h1
  ) %>

  <div class="flex gap-2">
    <%= link_to recording_studio_categorisable.edit_category_group_path(@category_group_recording), class: "inline-flex" do %>
      <%= render FlatPack::Button::Component.new(
        text: "Edit",
        style: :secondary,
        size: :md
      ) %>
    <% end %>
    <%= link_to recording_studio_categorisable.category_group_path(@category_group_recording), 
                method: :delete, 
                data: { turbo_method: :delete, turbo_confirm: "Are you sure?" },
                class: "inline-flex" do %>
      <%= render FlatPack::Button::Component.new(
        text: "Delete",
        style: :danger,
        size: :md
      ) %>
    <% end %>
    <%= link_to recording_studio_categorisable.new_category_group_category_item_path(@category_group_recording), 
                class: "inline-flex" do %>
      <%= render FlatPack::Button::Component.new(
        text: "New Category Item",
        style: :primary,
        size: :md
      ) %>
    <% end %>
  </div>

  <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
    <% card.header do %>
      <%= render FlatPack::PageTitle::Component.new(
        title: "Category Items",
        subtitle: "#{@category_items.count} item(s) in this group",
        variant: :h3,
        class: "mb-0 pb-0"
      ) %>
    <% end %>

    <% card.body do %>
      <% if @category_items.any? %>
        <div class="divide-y divide-gray-200">
          <% @category_items.each do |item_recording| %>
            <% item = item_recording.recordable %>
            <div class="py-3 flex items-center justify-between">
              <div>
                <h5 class="text-sm font-medium text-gray-900"><%= item.label %></h5>
              </div>
              <div class="flex gap-2">
                <%= link_to recording_studio_categorisable.edit_category_group_category_item_path(@category_group_recording, item_recording), 
                            class: "inline-flex" do %>
                  <%= render FlatPack::Button::Component.new(
                    text: "Edit",
                    style: :ghost,
                    size: :sm
                  ) %>
                <% end %>
                <%= link_to recording_studio_categorisable.category_group_category_item_path(@category_group_recording, item_recording),
                            method: :delete,
                            data: { turbo_method: :delete, turbo_confirm: "Are you sure?" },
                            class: "inline-flex" do %>
                  <%= render FlatPack::Button::Component.new(
                    text: "Delete",
                    style: :danger,
                    size: :sm
                  ) %>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-sm text-gray-500">No category items yet. Create one to get started.</p>
      <% end %>
    <% end %>
  <% end %>

  <div class="flex gap-2">
    <%= link_to recording_studio_categorisable.category_groups_path, class: "inline-flex" do %>
      <%= render FlatPack::Button::Component.new(
        text: "Back to Groups",
        style: :ghost,
        size: :md
      ) %>
    <% end %>
  </div>
</div>
