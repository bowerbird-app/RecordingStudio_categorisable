<% editable_fields = local_assigns.fetch(:editable_fields, { name: true, key: true, description: true }) %>
<% editable_field_count = editable_fields.values.count(true) %>

<%= form_with model: category_group, url: @category_group_recording ? category_group_path(@category_group_recording) : category_groups_path do |form| %>
  <% if category_group.errors[:base].present? %>
    <div class="mb-4 text-sm text-warning"><%= category_group.errors[:base].first %></div>
  <% end %>

  <% if @category_group_recording.present? && editable_field_count.zero? %>
    <div class="mb-4 text-sm text-(--surface-muted-content-color)">
      This category group is read-only in the current scope. No editable fields are allowed.
    </div>
  <% end %>

  <div class="space-y-4">
    <% if editable_fields[:name] %>
      <%= render FlatPack::TextInput::Component.new(
        name: "category_group[name]",
        label: "Name",
        value: category_group.name,
        error: category_group.errors[:name].first,
        required: true
      ) %>
    <% end %>

    <% if editable_fields[:key] %>
      <%= render FlatPack::TextInput::Component.new(
        name: "category_group[key]",
        label: "Key",
        value: category_group.key,
        error: category_group.errors[:key].first,
        required: true
      ) %>
    <% end %>

    <% if editable_fields[:description] %>
      <%= render FlatPack::TextArea::Component.new(
        name: "category_group[description]",
        label: "Description",
        value: category_group.description,
        rows: 4
      ) %>
    <% end %>

  </div>

  <div class="mt-6 flex flex-wrap gap-3">
    <% if @category_group_recording.blank? || editable_field_count.positive? %>
      <%= render FlatPack::Button::Component.new(text: submit_text, style: :primary, type: "submit") %>
    <% end %>
  </div>
<% end %>
