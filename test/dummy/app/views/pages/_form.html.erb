<%= form_with model: page, url: page.persisted? ? page_path(@page_recording) : pages_path do |form| %>
  <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
    <% card.body do %>
      <% if page.errors[:base].present? %>
        <div class="mb-4 text-sm text-warning"><%= page.errors[:base].first %></div>
      <% end %>

      <div class="space-y-4">
        <%= render FlatPack::TextInput::Component.new(
          name: "page[title]",
          label: "Title",
          value: page.title,
          error: page.errors[:title].first,
          required: true
        ) %>

        <%= render FlatPack::TextArea::Component.new(
          name: "page[body]",
          label: "Body",
          value: page.body,
          rows: 6
        ) %>

        <% @category_fields.each do |field_state| %>
          <% field = field_state.fetch(:field) %>
          <% item_recordings = field_state.fetch(:item_recordings) %>
          <div class="rounded-lg border border-[var(--card-border-color)] p-4">
            <div class="mb-3 text-sm font-medium text-[var(--surface-content-color)]"><%= field.label %></div>

            <% if field.single? %>
              <%= render FlatPack::Select::Component.new(
                name: "page[#{field.attribute_name}]",
                label: field.label,
                options: item_recordings.map { |item_recording| [item_recording.recordable.name, item_recording.id] },
                value: field.read(page)
              ) %>
            <% else %>
              <div class="space-y-2">
                <% selected_ids = Array(field.read(page)) %>
                <% item_recordings.each do |item_recording| %>
                  <%= render FlatPack::Checkbox::Component.new(
                    name: "page[#{field.attribute_name}][]",
                    label: item_recording.recordable.name,
                    value: item_recording.id,
                    checked: selected_ids.include?(item_recording.id)
                  ) %>
                <% end %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>

    <% card.footer do %>
      <div class="flex flex-wrap gap-3">
        <%= render FlatPack::Button::Component.new(text: submit_text, style: :primary, type: "submit") %>
        <%= render FlatPack::Button::Component.new(text: "Cancel", style: :ghost, url: pages_path) %>
      </div>
    <% end %>
  <% end %>
<% end %>
