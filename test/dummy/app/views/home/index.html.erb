<div class="mx-auto flex w-full max-w-6xl flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: @workspace&.name || "RecordingStudio Categorisable",
    subtitle: "Category management addon for RecordingStudio - organize and categorize your recordings",
    variant: :h1
  ) %>

  <div class="grid gap-6 lg:grid-cols-[minmax(0,2fr)_minmax(320px,1fr)]">
    <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: "Category Management",
          subtitle: "Create and manage category groups and items to organize your recordings.",
          variant: :h3,
          class: "mb-0 pb-0"
        ) %>
      <% end %>

      <% card.body do %>
        <div class="space-y-4">
          <p class="text-sm leading-6 text-[var(--surface-content-color)]">
            This addon provides a flexible categorization system built on top of RecordingStudio:
          </p>
          <ul class="space-y-2 text-sm leading-6 text-[var(--surface-content-color)]">
            <li><strong>Category Groups:</strong> Container for related category items (e.g., "Project Status", "Priority")</li>
            <li><strong>Category Items:</strong> Individual categories within a group (e.g., "Active", "High")</li>
            <li><strong>Category Assignments:</strong> Link recordings to category items for organization and filtering</li>
          </ul>
        </div>
      <% end %>

      <% card.footer do %>
        <%= link_to recording_studio_categorisable.root_path, class: "inline-flex" do %>
          <%= render FlatPack::Button::Component.new(
            text: "Manage Categories",
            style: :primary,
            size: :md
          ) %>
        <% end %>
      <% end %>
    <% end %>

    <div class="flex flex-col gap-6">
      <%= render FlatPack::Card::Component.new(style: :outlined) do |card| %>
        <% card.header do %>
          <%= render FlatPack::PageTitle::Component.new(
            title: "Workspace state",
            subtitle: "Current workspace and authentication status.",
            variant: :h3,
            class: "mb-0 pb-0"
          ) %>
        <% end %>

        <% card.body do %>
          <dl class="space-y-3 text-sm">
            <div>
              <dt class="text-[var(--surface-muted-content-color)]">Workspace</dt>
              <dd class="font-medium"><%= @workspace&.name || "Not seeded" %></dd>
            </div>
            <div>
              <dt class="text-[var(--surface-muted-content-color)]">Root recording</dt>
              <dd class="font-mono text-xs"><%= @root_recording&.id || "Missing" %></dd>
            </div>
            <div>
              <dt class="text-[var(--surface-muted-content-color)]">Signed in as</dt>
              <dd class="font-medium"><%= current_user.email %></dd>
            </div>
          </dl>
        <% end %>
      <% end %>

      <%= render FlatPack::Card::Component.new(style: :outlined) do |card| %>
        <% card.header do %>
          <%= render FlatPack::PageTitle::Component.new(
            title: "Demo data",
            subtitle: "Pre-seeded category groups for exploration.",
            variant: :h3,
            class: "mb-0 pb-0"
          ) %>
        <% end %>

        <% card.body do %>
          <ul class="space-y-2 text-sm">
            <li><strong>Project Status</strong> - Planning, Active, On Hold, etc.</li>
            <li><strong>Priority</strong> - Low, Medium, High, Critical</li>
            <li><strong>Team</strong> - Engineering, Design, Product, etc.</li>
          </ul>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
