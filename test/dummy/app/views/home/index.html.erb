<div class="mx-auto flex w-full max-w-6xl flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: @workspace&.name || "Recording Studio addon template",
    subtitle: "Use this dummy app to validate authentication, root recording setup, category management, and page edit flows.",
    variant: :h1
  ) %>

  <div class="grid gap-6 lg:grid-cols-[minmax(0,2fr)_minmax(320px,1fr)]">
    <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: "Template workflow",
          subtitle: "The first things to change when you turn this into a real addon.",
          variant: :h3,
          class: "mb-0 pb-0"
        ) %>
      <% end %>

        <% card.body do %>
          <ol class="space-y-4 text-sm leading-6 text-[var(--surface-content-color)]">
            <li>
              Manage category groups and items at <code>/recording_studio_categorisable</code>.
            </li>
            <li>
              Edit the seeded demo page at <code>/pages</code> to exercise one single-select and one multi-select category field.
            </li>
            <li>
              Register categorisable recordables explicitly so usage counting never guesses from the database.
            </li>
            <li>
              Use this dummy app to check layout, authentication, Tailwind sources, root recording behavior, and usage-aware destructive actions.
            </li>
          </ol>
        <% end %>
    <% end %>

    <div class="flex flex-col gap-6">
      <%= render FlatPack::Card::Component.new(style: :outlined) do |card| %>
        <% card.header do %>
          <%= render FlatPack::PageTitle::Component.new(
            title: "Workspace state",
            subtitle: "The seeded Recording Studio baseline for local development.",
            variant: :h3,
            class: "mb-0 pb-0"
          ) %>
        <% end %>

        <% card.body do %>
          <dl class="space-y-3 text-sm">
            <div>
              <dt class="text-[var(--surface-muted-content-color)]">Workspace</dt>
              <dd class="font-medium"><%= @workspace&.name || "Not seeded" %></dd>
            </div>
            <div>
              <dt class="text-[var(--surface-muted-content-color)]">Root recording</dt>
              <dd class="font-mono text-xs"><%= @root_recording&.id || "Missing" %></dd>
            </div>
            <div>
              <dt class="text-[var(--surface-muted-content-color)]">Signed in as</dt>
              <dd class="font-medium"><%= current_user.email %></dd>
            </div>
            <div>
              <dt class="text-[var(--surface-muted-content-color)]">Category groups</dt>
              <dd class="font-medium"><%= @category_group_count %></dd>
            </div>
          </dl>
        <% end %>
      <% end %>

      <%= render FlatPack::Card::Component.new(style: :outlined) do |card| %>
        <% card.header do %>
          <%= render FlatPack::PageTitle::Component.new(
            title: "Useful routes",
            subtitle: "Quick links for checking the mounted engine and local app shell.",
            variant: :h3,
            class: "mb-0 pb-0"
          ) %>
        <% end %>

        <% card.body do %>
          <div class="space-y-3 text-sm">
            <p><strong>App home:</strong> <code>/</code></p>
            <p><strong>Recording Studio mount:</strong> <code>/recording_studio</code></p>
            <p><strong>Categories mount:</strong> <code>/recording_studio_categorisable</code></p>
            <p><strong>Page editor:</strong> <code>/pages</code></p>
            <p><strong>Health check:</strong> <code>/up</code></p>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>

  <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
    <% card.header do %>
      <%= render FlatPack::PageTitle::Component.new(
        title: "Seeded pages",
        subtitle: "The page edit flow demonstrates single-select and multi-select category fields backed by category item recording IDs.",
        variant: :h3,
        class: "mb-0 pb-0"
      ) %>
    <% end %>

    <% card.body do %>
      <div class="space-y-3 text-sm">
        <% @page_recordings.each do |page_recording| %>
          <div class="flex items-center justify-between gap-4 rounded-lg border border-[var(--card-border-color)] p-4">
            <div>
              <div class="font-medium"><%= page_recording.recordable.title %></div>
              <div class="text-[var(--surface-muted-content-color)]"><%= truncate(page_recording.recordable.body, length: 80) %></div>
            </div>

            <%= render FlatPack::Button::Component.new(
              text: "Edit page",
              style: :secondary,
              url: edit_page_path(page_recording)
            ) %>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
