<div class="mx-auto flex w-full max-w-6xl flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Category behavior examples",
    subtitle: "This screen demonstrates how category assignments behave for both single-select and multi-select recordables.",
    variant: :h3,
    class: "mb-0 pb-0"
  ) do |title| %>
    <% title.actions do %>
      <div class="flex flex-wrap gap-2">
        <% if workspace_root_selected? %>
          <%= render FlatPack::Button::Component.new(
            text: "Add Page",
            style: :secondary,
            url: new_page_path
          ) %>
          <%= render FlatPack::Button::Component.new(
            text: "Add Brief",
            style: :secondary,
            url: new_brief_path
          ) %>
        <% end %>
        <% if defined?(RecordingStudioAdmin::Engine) %>
          <%= render FlatPack::Button::Component.new(
            text: "Admin Root",
            style: :secondary,
            url: "/admin"
          ) %>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <div class="flex flex-wrap items-center justify-between gap-4 rounded-lg border border-(--card-border-color) p-4 text-sm">
    <div>
      <div class="font-medium">Category groups</div>
      <div class="text-(--surface-muted-content-color)"><%= @category_group_count %> total groups</div>
    </div>

    <%= render FlatPack::Button::Component.new(
      text: "Manage Categories",
      style: :secondary,
      url: "/recording_studio_categorisable"
    ) %>
  </div>

  <% recordable_cell = lambda do |recording|
       render FlatPack::Badge::Component.new(text: recording.recordable_type.demodulize, style: :info, size: :sm)
     end %>

  <% title_cell = lambda do |recording|
       recording.recordable.title
     end %>

  <% summary_cell = lambda do |recording|
       truncate(recording.recordable.body, length: 100)
     end %>

  <% actions_cell = lambda do |recording|
       edit_url = if recording.recordable_type == "Page"
                    edit_page_path(recording)
                  else
                    edit_brief_path(recording)
                  end

       render FlatPack::Button::Component.new(
         text: "Edit",
         style: :secondary,
         size: :sm,
         url: edit_url
       )
     end %>

  <%= render FlatPack::Table::Component.new(data: @recordable_rows) do |table| %>
    <% table.column(title: "Recordable", html: recordable_cell) %>
    <% table.column(title: "Title", html: title_cell) %>
    <% table.column(title: "Summary", html: summary_cell) %>
    <% table.column(title: "Actions", html: actions_cell) %>
  <% end %>
</div>
