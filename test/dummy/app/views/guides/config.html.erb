<div class="mx-auto flex w-full max-w-5xl flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Config",
    subtitle: "Runtime configuration and capabilities setup for root-scoped category behavior.",
    variant: :h1
  ) %>

  <div class="space-y-8 text-sm leading-6 text-(--surface-content-color)">
    <section class="space-y-2">
      <h2 class="text-base font-semibold">Runtime configuration</h2>
      <p class="text-(--surface-muted-content-color)">Configure the engine with root resolution and authorization. Both are required unless your controller already defines compatible fallback methods.</p>
      <pre class="overflow-auto rounded-md bg-(--surface-muted-background-color) p-4 text-xs"><code>RecordingStudioCategorisable.configure do |config|
  # Optional: UI title shown in the mounted engine
  config.ui_title = "Categories"

  # REQUIRED unless your app controller already exposes current_root_recording.
  # Must return the active root recording for the current request.
  config.root_recording_resolver = ->(controller) { controller.current_root_recording }

  # REQUIRED unless your app controller already exposes
  # authorize_recording_studio_categorisable!.
  # Return true/false to authorize engine access.
  config.authorization_resolver = ->(controller) { controller.current_user.present? }

  # OPTIONAL: customize unauthorized responses (403) with your own behavior.
  # config.unauthorized_response_handler = ->(controller, exception) do
  #   controller.render plain: exception.message, status: :forbidden
  # end
end</code></pre>

    </section>

    <section class="space-y-2">
      <h2 class="text-base font-semibold">Capabilities setup</h2>
      <p class="text-(--surface-muted-content-color)">Use the RecordingStudio capability API, then apply options through Categorisable.apply_for. This is the active pattern used in this dummy app.</p>
      <pre class="overflow-auto rounded-md bg-(--surface-muted-background-color) p-4 text-xs"><code># Root recordable (Workspace/Admin/etc.)
class Workspace &lt; ApplicationRecord
  recording_studio_recordable label: "Workspace", root: true

  RecordingStudio.enable_capability(:categorisable, on: self)
  RecordingStudio.set_capability_options(
    :categorisable,
    on: self,
    category_groups: [
      {
        key: "page-status",
        allow: {
          rename: true,
          update_description: false
        }
      },
      {
        key: "page-topics",
        allow: {
          rename: false,
          update_description: false
        }
      }
    ],
    category_items: [
      {
        group_key: "page-status",
        allow: {
          create: true,
          update_name: true,
          update_description: true,
          orderable: false,
          delete: false
        }
      },
      {
        group_key: "page-topics",
        allow: {
          create: false,
          update_name: false,
          update_description: false,
          orderable: false,
          delete: true
        }
      }
    ],
    references: [
      {
        attribute_name: :status_category_item_recording_id,
        selection: :single,
        category_group_key: "page-status",
        label: "Status"
      },
      {
        attribute_name: :topic_category_item_recording_ids,
        selection: :multiple,
        category_group_key: "page-topics",
        label: "Topics"
      }
    ]
  )

  RecordingStudioCategorisable::Capabilities::Categorisable.apply_for(self)
end

# Child recordable can register reference-only options
class Page &lt; ApplicationRecord
  RecordingStudio.enable_capability(:categorisable, on: self)
  RecordingStudio.set_capability_options(
    :categorisable,
    on: self,
    references: [
      {
        attribute_name: :status_category_item_recording_id,
        selection: :single,
        category_group_key: "page-status",
        label: "Status"
      }
    ]
  )

  RecordingStudioCategorisable::Capabilities::Categorisable.apply_for(self)
end

# Notes
# - orderable controls drag/reorder behavior for category items
# - category_groups and category_items are root-scoped policy/config
# - references bind model attributes to a category group key</code></pre>
    </section>

  </div>
</div>
