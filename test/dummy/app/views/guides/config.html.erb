<div class="mx-auto flex w-full max-w-5xl flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Config",
    subtitle: "Runtime configuration and capabilities setup for root-scoped category behavior.",
    variant: :h1
  ) %>

  <div class="space-y-8 text-sm leading-6 text-(--surface-content-color)">
    <section class="space-y-2">
      <h2 class="text-base font-semibold">Runtime configuration</h2>
      <p class="text-(--surface-muted-content-color)">Configure the engine with root resolution and authorization. Both are required unless your controller already defines compatible fallback methods.</p>
      <pre class="overflow-auto rounded-md bg-(--surface-muted-background-color) p-4 text-xs"><code>RecordingStudioCategorisable.configure do |config|
  # Optional: UI title shown in the mounted engine
  config.ui_title = "Categories"

  # REQUIRED unless your app controller already exposes current_root_recording.
  # Must return the active root recording for the current request.
  config.root_recording_resolver = ->(controller) { controller.current_root_recording }

  # REQUIRED unless your app controller already exposes
  # authorize_recording_studio_categorisable!.
  # Return true/false to authorize engine access.
  config.authorization_resolver = ->(controller) { controller.current_user.present? }

  # OPTIONAL: customize unauthorized responses (403) with your own behavior.
  # config.unauthorized_response_handler = ->(controller, exception) do
  #   controller.render plain: exception.message, status: :forbidden
  # end
end</code></pre>

    </section>

    <section class="space-y-2">
      <h2 class="text-base font-semibold">Capabilities setup</h2>
      <p class="text-(--surface-muted-content-color)">Use capabilities to define what category groups/items exist for each root type and how fields bind to those groups.</p>
      <pre class="overflow-auto rounded-md bg-(--surface-muted-background-color) p-4 text-xs"><code># Example: in each root recordable class (Workspace/Admin/etc.)
# root_recordable_type: use name to scope this capability to the class.

# ------------------------------------------------------------
# CategoryGroup capability
# ------------------------------------------------------------
RecordingStudioCategorisable::Capabilities::CategoryGroup.enabled(
  # REQUIRED: stable key used to find this group
  key: "page-topics",

  # REQUIRED: display name in UI
  name: "Page Topics",

  # OPTIONAL (default :edit): access role requirement for this group
  # Common values: :view, :edit, :admin
  access: :edit,

  # OPTIONAL: scope capability to this root recordable class only
  root_recordable_type: name,

  # OPTIONAL: per-action toggles (all default false)
  # rename              => allow changing group name
  # reorder             => reserved for ordering behavior
  # move                => allow changing parent in recording tree
  # update_description  => allow description edits
  allow: {
    rename: true,
    reorder: false,
    move: true,
    update_description: true
  }

  # OPTIONAL: any extra metadata can be passed via kwargs
)

# ------------------------------------------------------------
# CategoryItems capability
# ------------------------------------------------------------
RecordingStudioCategorisable::Capabilities::CategoryItems.enabled(
  # REQUIRED: group key that items belong to
  group_key: "page-topics",

  # OPTIONAL: scope capability to this root recordable class only
  root_recordable_type: name,

  # OPTIONAL: per-item action toggles (all default false)
  # create             => allow new items
  # update_name        => allow item name edits
  # update_description => allow description edits
  # update_position    => allow position edits
  # delete             => allow deletion
  allow: {
    create: true,
    update_name: true,
    update_description: true,
    update_position: true,
    delete: true
  }

  # OPTIONAL: extra metadata via kwargs
)

# ------------------------------------------------------------
# Reference capability
# ------------------------------------------------------------
RecordingStudioCategorisable::Capabilities::Reference.enabled(
  # REQUIRED: model class to attach category field behavior to
  recordable: self,

  # REQUIRED: attribute on the recordable model
  # single-select usually uses *_id
  # multiple-select usually uses *_ids (array)
  attribute_name: :topic_category_item_recording_ids,

  # REQUIRED: :single or :multiple
  selection: :multiple,

  # REQUIRED: group key this field points to
  category_group_key: "page-topics",

  # OPTIONAL: display label for generated field metadata/UI
  label: "Topics"

  # OPTIONAL: additional options are forwarded into field registration
)</code></pre>
    </section>

  </div>
</div>
