<div class="mx-auto flex w-full max-w-5xl flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Install",
    subtitle: "Host app setup for the categorisable engine.",
    variant: :h1
  ) %>

  <div class="space-y-6 text-sm leading-6 text-(--surface-content-color)">
    <div class="space-y-2">
      <h2 class="text-base font-semibold">1. Add the gem</h2>
      <pre class="overflow-auto rounded-md bg-(--surface-muted-background-color) p-4 text-xs"><code># Gemfile
gem "recording_studio_categorisable"</code></pre>
      <pre class="overflow-auto rounded-md bg-(--surface-muted-background-color) p-4 text-xs"><code>bundle install</code></pre>
    </div>

    <div class="space-y-2">
      <h2 class="text-base font-semibold">2. Run the install generator</h2>
      <pre class="overflow-auto rounded-md bg-(--surface-muted-background-color) p-4 text-xs"><code>bin/rails generate recording_studio_categorisable:install</code></pre>
      <p>This adds the initializer, mount route, migrations, and Tailwind sources used by the engine UI.</p>
    </div>

    <div class="space-y-2">
      <h2 class="text-base font-semibold">3. Configure authorization and root recording</h2>
      <pre class="overflow-auto rounded-md bg-(--surface-muted-background-color) p-4 text-xs"><code># config/initializers/recording_studio_categorisable.rb
RecordingStudioCategorisable.configure do |config|
  config.ui_title = "Categories"

  # Optional if your ApplicationController already provides
  # current_root_recording and authorize_recording_studio_categorisable!.
  config.root_recording_resolver = ->(controller) { controller.send(:current_root_recording) }
  config.authorization_resolver = ->(controller) { controller.current_user.present? }

  # Optional 403 customization
  # config.unauthorized_response_handler = ->(controller, exception) do
  #   controller.render("errors/forbidden", status: :forbidden)
  # end
end</code></pre>
    </div>

    <div class="space-y-2">
      <h2 class="text-base font-semibold">4. Apply migrations</h2>
      <pre class="overflow-auto rounded-md bg-(--surface-muted-background-color) p-4 text-xs"><code>bin/rails db:migrate</code></pre>
    </div>

    <div class="space-y-2">
      <h2 class="text-base font-semibold">5. Register categorisable fields</h2>
      <pre class="overflow-auto rounded-md bg-(--surface-muted-background-color) p-4 text-xs"><code>class Page < ApplicationRecord
  include RecordingStudioCategorisable::Categorisable

  categorises :status_category_item_recording_id,
    selection: :single,
    category_group_key: "page-status",
    label: "Status"

  categorises :topic_category_item_recording_ids,
    selection: :multiple,
    category_group_key: "page-topics",
    label: "Topics"
end</code></pre>
    </div>

    <div class="space-y-2">
      <h2 class="text-base font-semibold">6. Open the mounted UI</h2>
      <pre class="overflow-auto rounded-md bg-(--surface-muted-background-color) p-4 text-xs"><code>/recording_studio_categorisable</code></pre>
    </div>
  </div>
</div>
