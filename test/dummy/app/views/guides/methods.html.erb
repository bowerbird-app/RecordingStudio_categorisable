<div class="mx-auto flex w-full max-w-5xl flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Methods",
    subtitle: "Model methods exposed by the categorisable DSL.",
    variant: :h1
  ) %>

  <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
    <% card.body do %>
      <div class="space-y-4 text-sm leading-6 text-[var(--surface-content-color)]">
        <p>Include the concern on a recordable model, then declare category-backed attributes.</p>
        <pre class="overflow-auto rounded-md bg-[var(--surface-muted-background-color)] p-4 text-xs"><code>class Page < ApplicationRecord
  include RecordingStudioCategorisable::Categorisable

  categorises :status_category_item_recording_id,
    selection: :single,
    category_group_slug: "page-status",
    label: "Status"
end</code></pre>
      </div>
    <% end %>
  <% end %>
</div>
