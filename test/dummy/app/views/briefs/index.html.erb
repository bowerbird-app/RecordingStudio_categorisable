<div class="mx-auto flex w-full max-w-6xl flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Briefs",
    subtitle: "Briefs showcase the single-select categorisable component.",
    variant: :h1
  ) do |title| %>
    <% title.actions do %>
      <%= render FlatPack::Button::Component.new(text: "New brief", style: :primary, url: new_brief_path) %>
    <% end %>
  <% end %>

  <div class="grid gap-6">
    <% @brief_recordings.each do |brief_recording| %>
      <% brief = brief_recording.recordable %>
      <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
        <% card.header do %>
          <div class="flex flex-wrap items-start justify-between gap-4">
            <%= render FlatPack::PageTitle::Component.new(
              title: brief.title,
              subtitle: truncate(brief.body, length: 120),
              variant: :h3,
              class: "mb-0 pb-0"
            ) %>

            <%= render FlatPack::Button::Component.new(text: "Edit", style: :secondary, url: edit_brief_path(brief_recording)) %>
          </div>
        <% end %>

        <% card.body do %>
          <% if brief.status_category_item_recording_id.present? %>
            <%= render FlatPack::Badge::Component.new(text: "Status set", style: :info, size: :sm) %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>
