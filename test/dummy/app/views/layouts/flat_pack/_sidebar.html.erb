<%= render FlatPack::Sidebar::Component.new(side: sidebar_side) do |sidebar| %>
  <% sidebar.header do %>
    <%= render FlatPack::Sidebar::Header::Component.new(
      brand_abbr: "RS",
      title: "Categorisable",
      subtitle: "Recording Studio"
    ) %>
  <% end %>

  <% sidebar.items do %>
    <nav class="py-4 space-y-1" aria-label="Main navigation">
      <%= render FlatPack::Sidebar::Item::Component.new(
        label: "Home",
        href: "/",
        icon: :home
      ) %>

      <%= render FlatPack::Sidebar::Item::Component.new(
        label: "Install",
        href: "/install",
        icon: :arrow_down_tray
      ) %>

      <%= render FlatPack::Sidebar::Item::Component.new(
        label: "Config",
        href: "/config",
        icon: :cog_6_tooth
      ) %>

      <%= render FlatPack::Sidebar::Item::Component.new(
        label: "Methods",
        href: "/methods",
        icon: :code_bracket
      ) %>

      <%= render FlatPack::Sidebar::Item::Component.new(
        label: "Components",
        href: "/components",
        icon: :rectangle_group
      ) %>

      <%= render FlatPack::Sidebar::Item::Component.new(
        label: "Recording Tree",
        href: "/recording-tree",
        icon: :share
      ) %>

      <%= render FlatPack::Sidebar::Item::Component.new(
        label: "Recording Studio",
        href: "/recording_studio",
        icon: :folder
      ) %>

      <%= render FlatPack::Sidebar::Item::Component.new(
        label: "Categories",
        href: "/recording_studio_categorisable",
        icon: :tag
      ) %>

      <%= render FlatPack::Sidebar::Item::Component.new(
        label: "Pages",
        href: "/pages",
        icon: :file_text
      ) %>

      <%= render FlatPack::Sidebar::Item::Component.new(
        label: "Briefs",
        href: "/briefs",
        icon: :document_text
      ) %>

      <%= render FlatPack::Sidebar::Item::Component.new(
        label: "Health",
        href: "/up",
        icon: :activity
      ) %>

    </nav>
  <% end %>

  <% sidebar.footer do %>
    <%= render FlatPack::Sidebar::Footer::Component.new(class: "text-sm text-[var(--surface-muted-content-color)]") do %>
      <%= render FlatPack::Sidebar::Item::Component.new(
        label: "Sign out",
        href: main_app.destroy_user_session_path,
        icon: :lock,
        class: "mx-0",
        data: { turbo_method: :delete }
      ) %>
    <% end %>
  <% end %>
<% end %>
